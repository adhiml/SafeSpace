PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/safespace

# Development only: password given to the demo accounts the first time the server seeds them
# DEMO_PASSWORD=safespace123

# Email verification is not built yet, so new accounts count as verified when they sign up.
# Set to true once the verification email exists: sign-ups then start unverified and are blocked until verified.
# REQUIRE_EMAIL_VERIFICATION=false

# The old X-Demo-User-Id header (seeded demo accounts only). Always off in production; set false to turn it off in development too.
# ALLOW_DEMO_HEADER=true

# How emails are delivered. "console" prints them in the server terminal (development only).
# EMAIL_MODE=console
